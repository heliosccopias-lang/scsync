# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32 bytes in base64, encrypts each company's Asaas API key. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Public URL Asaas calls for webhooks, e.g. https://scsync.vercel.app
APP_URL=

# Optional: Vercel "Protection Bypass for Automation" secret, so Asaas can reach a protected deployment
VERCEL_AUTOMATION_BYPASS_SECRET=

# Secret Vercel Cron sends as Bearer token
CRON_SECRET=
